@page "/result"
@inject QuizSession Session
@inject NavigationManager Nav

<PageTitle>Wynik — Olympiad Quizzer</PageTitle>

@if (!Session.IsStarted)
{
    Nav.NavigateTo(Nav.BaseUri);
    return;
}

<h1 class="score-heading">@Session.Score / @Session.MaxScore</h1>
<p>Twój wynik z quizu.</p>

<table class="breakdown-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Typ</th>
            <th>Wynik</th>
            <th>Punkty</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Session.Questions.Count; i++)
        {
            var q = Session.Questions[i];
            var r = Session.Results[i];
            var hit = r is not null && r.IsCorrect;
            <tr>
                <td>@(i + 1)</td>
                <td>@TypeLabel(q.Type)</td>
                <td class="@(hit ? "hit" : "miss")">@(hit ? "+" : "−")</td>
                <td>@(r?.PointsAwarded.ToString("G3") ?? "—") / @q.Points</td>
            </tr>
        }
    </tbody>
</table>

<p style="margin-top:1.5rem;">
    <button class="btn" @onclick="Restart">Jeszcze raz</button>
</p>

@code {
    void Restart()
    {
        Session.Start(new List<Question>());
        Nav.NavigateTo("quiz");
    }

    static string TypeLabel(QuestionType t) => t switch
    {
        QuestionType.MultiSelect  => "Wielokrotny wybór",
        QuestionType.SingleAbcd   => "Jednokrotny wybór",
        QuestionType.ShortAnswer  => "Odpowiedź otwarta",
        QuestionType.TrueFalse    => "Prawda/fałsz",
        QuestionType.Ordering     => "Kolejność",
        QuestionType.Matching     => "Dopasowanie",
        _                         => "Nieznany"
    };
}
