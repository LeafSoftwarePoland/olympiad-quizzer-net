@page "/quiz"
@inject IQuestionRepository Repo
@inject QuizSession Session
@inject NavigationManager Nav

<PageTitle>Quiz — Olympiad Quizzer</PageTitle>

@if (_loading)
{
    <p class="quiz-progress">Budzenie serwera… może potrwać do minuty.</p>
}
else if (_error is not null)
{
    <div class="error-panel" role="alert">
        <p>Nie udało się załadować pytań: @_error</p>
        <button class="btn" @onclick="LoadAsync">Spróbuj ponownie</button>
    </div>
}
else if (Session.Questions.Count == 0)
{
    <div class="error-panel" role="alert">
        <p>Brak pytań do wyświetlenia.</p>
        <button class="btn" @onclick="LoadAsync">Spróbuj ponownie</button>
    </div>
}
else
{
    var q = Session.Questions[_idx];

    <div class="quiz-header">
        <span class="quiz-progress">@(_idx + 1) / @Session.Questions.Count</span>
    </div>

    <QuestionRenderer Question="q" Submission="_submission" ReadOnly="_revealed" />

    @if (!_revealed)
    {
        <button class="btn" @onclick="Check">Sprawdź</button>
    }
    else
    {
        <div class="quiz-revealed-layout @(HasExplanation(q) ? "has-explanation" : "")">
            <div class="quiz-left">
                <div class="verdict @(_result!.IsCorrect ? "verdict-correct" : "verdict-wrong")" aria-live="polite">
                    @if (_result.IsCorrect)
                    {
                        <span>POPRAWNIE</span>
                    }
                    else
                    {
                        <span>BŁĄD</span>
                    }
                </div>

                @if (!_result.IsCorrect)
                {
                    <div class="correct-answer-block">
                        <strong>Poprawna odpowiedź:</strong> @CorrectAnswerText(q)
                    </div>
                }

                <button class="btn" @ref="_nextButton" @onclick="Advance">
                    @(_idx < Session.Questions.Count - 1 ? "Dalej" : "Zobacz wynik")
                </button>
            </div>
            @if (HasExplanation(q))
            {
                <div class="explanation-panel">
                    <h2>Wyjaśnienie:</h2>
                    <BlockRenderer Blocks="q.Explanation!" />
                </div>
            }
        </div>
    }
}

@code {
    bool _loading = true;
    string? _error;
    int _idx;
    AnswerSubmission _submission = new();
    bool _revealed;
    GradeResult? _result;
    ElementReference _nextButton;
    int _prevIdx = -1;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsStarted)
            await LoadAsync();
        else
            _loading = false;

        _idx = Session.CurrentIndex;
    }

    async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var questions = await Repo.GetAsync(QuizFilter.None);
            if (questions.Count == 0)
            {
                _loading = false;
                return;
            }
            Session.Start(questions);
            _idx = 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
        ResetQuestion();
    }

    void Check()
    {
        var q = Session.Questions[_idx];
        _result = Grader.Grade(q, _submission);
        Session.Record(_idx, _result);
        _revealed = true;
    }

    void Advance()
    {
        if (_idx < Session.Questions.Count - 1)
        {
            Session.CurrentIndex = ++_idx;
            ResetQuestion();
        }
        else
        {
            Nav.NavigateTo("result");
        }
    }

    void ResetQuestion()
    {
        _submission = new AnswerSubmission();
        _revealed = false;
        _result = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealed && _prevIdx != _idx)
        {
            _prevIdx = _idx;
            try { await _nextButton.FocusAsync(); } catch { }
        }
    }

    static bool HasExplanation(Question q) => q.Explanation is { Count: > 0 };

    static string CorrectAnswerText(Question q) => q.Type switch
    {
        QuestionType.MultiSelect or QuestionType.SingleAbcd =>
            string.Join(", ", q.CorrectIndices().Select(i =>
                i < (q.Options?.Count ?? 0) ? $"{(char)('A' + i)}: {q.Options![i]}" : $"[{i}]")),
        QuestionType.ShortAnswer =>
            string.Join(" / ", q.CorrectStrings()),
        QuestionType.TrueFalse =>
            string.Join(", ", q.CorrectBooleans().Select((b, i) =>
                $"{(i < (q.Options?.Count ?? 0) ? q.Options![i] : i.ToString())}: {(b ? "Prawda" : "Fałsz")}")),
        QuestionType.Ordering =>
            string.Join(" → ", q.CorrectIndices().Select(i =>
                i < (q.Options?.Count ?? 0) ? q.Options![i] : $"[{i}]")),
        QuestionType.Matching =>
            string.Join(", ", q.CorrectIndices().Select((ri, li) =>
                $"{(li < (q.Options?.Count ?? 0) ? q.Options![li] : $"[{li}]")} → {(ri < (q.MatchOptions?.Count ?? 0) ? q.MatchOptions![ri] : $"[{ri}]")}")),
        _ => ""
    };
}
