@{
    EnsureInit();
}

<p style="color:var(--text-dim);font-size:0.88rem;margin-bottom:0.5rem;">Ułóż elementy we właściwej kolejności (▲ w górę, ▼ w dół).</p>

<ol class="ordering-list">
    @for (int pos = 0; pos < _displayOrder.Count; pos++)
    {
        var p = pos;
        var optionIdx = _displayOrder[p];
        var label = optionIdx < (Question.Options?.Count ?? 0) ? Question.Options![optionIdx] : $"[{optionIdx}]";
        <li>
            <button class="ordering-btn" disabled="@(ReadOnly || p == 0)"
                    aria-label="@($"Przesuń w górę: {label}")"
                    @onclick="() => MoveUp(p)">▲</button>
            <button class="ordering-btn" disabled="@(ReadOnly || p == _displayOrder.Count - 1)"
                    aria-label="@($"Przesuń w dół: {label}")"
                    @onclick="() => MoveDown(p)">▼</button>
            <span>@label</span>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public Question Question { get; set; } = default!;
    [Parameter, EditorRequired] public AnswerSubmission Submission { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    List<int> _displayOrder = new();

    void EnsureInit()
    {
        int count = Question.Options?.Count ?? 0;
        if (_displayOrder.Count == count) return;
        _displayOrder = Enumerable.Range(0, count).ToList();
        SyncSubmission();
    }

    void SyncSubmission()
    {
        Submission.Order.Clear();
        Submission.Order.AddRange(_displayOrder);
    }

    void MoveUp(int pos)
    {
        if (pos <= 0) return;
        (_displayOrder[pos - 1], _displayOrder[pos]) = (_displayOrder[pos], _displayOrder[pos - 1]);
        SyncSubmission();
    }

    void MoveDown(int pos)
    {
        if (pos >= _displayOrder.Count - 1) return;
        (_displayOrder[pos], _displayOrder[pos + 1]) = (_displayOrder[pos + 1], _displayOrder[pos]);
        SyncSubmission();
    }
}
