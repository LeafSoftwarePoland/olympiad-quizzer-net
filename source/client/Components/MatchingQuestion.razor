@{
    EnsureInit();
}

<ul class="options-list">
    @for (int i = 0; i < (Question.Options?.Count ?? 0); i++)
    {
        var idx = i;
        var leftLabel = Question.Options![idx];
        var currentVal = Submission.Matches.Count > idx ? Submission.Matches[idx] : -1;
        <li>
            <span style="min-width:8rem;flex-shrink:0;">@leftLabel</span>
            <select class="select-input"
                    aria-label="@leftLabel"
                    disabled="@ReadOnly"
                    value="@currentVal"
                    @onchange="e => SetMatch(idx, ParseSelect(e.Value))">
                <option value="-1">— wybierz —</option>
                @for (int j = 0; j < (Question.MatchOptions?.Count ?? 0); j++)
                {
                    var rightIdx = j;
                    <option value="@rightIdx">@Question.MatchOptions![rightIdx]</option>
                }
            </select>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public Question Question { get; set; } = default!;
    [Parameter, EditorRequired] public AnswerSubmission Submission { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    void EnsureInit()
    {
        int count = Question.Options?.Count ?? 0;
        while (Submission.Matches.Count < count)
            Submission.Matches.Add(-1);
    }

    void SetMatch(int idx, int rightIdx)
    {
        EnsureInit();
        Submission.Matches[idx] = rightIdx;
    }

    static int ParseSelect(object? val) =>
        int.TryParse(val?.ToString(), out var n) ? n : -1;
}
