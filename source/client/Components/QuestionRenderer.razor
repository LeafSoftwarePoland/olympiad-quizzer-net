<ContentRenderer Question="Question" />

@switch (Question.Type)
{
    case QuestionType.MultiSelect:
        <MultiSelectQuestion Question="Question" Submission="Submission" ReadOnly="ReadOnly" />
        break;
    case QuestionType.SingleAbcd:
        <SingleAbcdQuestion Question="Question" Submission="Submission" ReadOnly="ReadOnly" />
        break;
    case QuestionType.ShortAnswer:
        <ShortAnswerQuestion Question="Question" Submission="Submission" ReadOnly="ReadOnly" />
        break;
    case QuestionType.TrueFalse:
        <TrueFalseQuestion Question="Question" Submission="Submission" ReadOnly="ReadOnly" />
        break;
    case QuestionType.Ordering:
        <OrderingQuestion Question="Question" Submission="Submission" ReadOnly="ReadOnly" />
        break;
    case QuestionType.Matching:
        <MatchingQuestion Question="Question" Submission="Submission" ReadOnly="ReadOnly" />
        break;
    default:
        <p>Nieobsługiwany typ pytania.</p>
        break;
}

@code {
    [Parameter, EditorRequired] public Question Question { get; set; } = default!;
    [Parameter, EditorRequired] public AnswerSubmission Submission { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
}
