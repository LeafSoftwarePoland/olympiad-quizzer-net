@{
    EnsureInit();
}

@for (int i = 0; i < (Question.Options?.Count ?? 0); i++)
{
    var idx = i;
    var statement = Question.Options![idx];
    var trueId = $"tf-t-{Question.Id}-{idx}";
    var falseId = $"tf-f-{Question.Id}-{idx}";

    <div role="radiogroup" aria-label="@statement" style="margin-bottom:0.8rem;">
        <p>@statement</p>
        <label style="margin-right:1.2rem;">
            <input type="radio"
                   name="@($"tf-{Question.Id}-{idx}")"
                   id="@trueId"
                   disabled="@ReadOnly"
                   checked="@(Submission.Booleans.Count > idx && Submission.Booleans[idx] == true)"
                   @onchange="() => SetBool(idx, true)" />
            Prawda
        </label>
        <label>
            <input type="radio"
                   name="@($"tf-{Question.Id}-{idx}")"
                   id="@falseId"
                   disabled="@ReadOnly"
                   checked="@(Submission.Booleans.Count > idx && Submission.Booleans[idx] == false)"
                   @onchange="() => SetBool(idx, false)" />
            Fałsz
        </label>
    </div>
}

@code {
    [Parameter, EditorRequired] public Question Question { get; set; } = default!;
    [Parameter, EditorRequired] public AnswerSubmission Submission { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }

    void EnsureInit()
    {
        int count = Question.Options?.Count ?? 0;
        while (Submission.Booleans.Count < count)
            Submission.Booleans.Add(null);
    }

    void SetBool(int idx, bool val)
    {
        EnsureInit();
        Submission.Booleans[idx] = val;
    }
}
