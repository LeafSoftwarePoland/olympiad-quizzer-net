@inherits LayoutComponentBase
@inject HttpClient Http
<NavMenu />
<div class="font-controls">
    <button class="btn btn-sm" @onclick="DecreaseFont" title="Zmniejsz tekst">A−</button>
    <button class="btn btn-sm" @onclick="IncreaseFont" title="Zwiększ tekst">A+</button>
    <button class="btn btn-sm" @onclick="ToggleTheme" title="Zmień motyw">◑</button>
</div>
<main>
    @Body
</main>
<footer class="app-footer">
    <span>LeafSoftware Tomasz Mankin &copy; 2026</span>
    @if (!string.IsNullOrEmpty(_version))
    {
        <span class="footer-version">v@_version</span>
    }
</footer>

@code {
    private int _fontSize = 17;
    private string _theme = "dark";
    private string _version = "";

    private void IncreaseFont()
    {
        _fontSize = Math.Min(_fontSize + 1, 26);
        ApplyFont();
    }

    private void DecreaseFont()
    {
        _fontSize = Math.Max(_fontSize - 1, 13);
        ApplyFont();
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async void ApplyFont()
    {
        await JS.InvokeVoidAsync("eval", $"document.documentElement.style.fontSize='{_fontSize}px'");
    }

    private async Task ToggleTheme()
    {
        _theme = _theme == "dark" ? "ps" : "dark";
        var attr = _theme == "ps" ? "ps" : "";
        await JS.InvokeVoidAsync("eval",
            $"document.documentElement.setAttribute('data-theme','{attr}'); localStorage.setItem('theme','{attr}')");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string?>("eval", "localStorage.getItem('theme')");
            if (saved == "ps")
            {
                _theme = "ps";
                await JS.InvokeVoidAsync("eval", "document.documentElement.setAttribute('data-theme','ps')");
            }
            try
            {
                var v = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("version.json");
                _version = v.GetProperty("frontend").GetString() ?? "";
                StateHasChanged();
            }
            catch { }
        }
    }
}
