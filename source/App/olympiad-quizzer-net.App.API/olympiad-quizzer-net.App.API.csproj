<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>olympiad-quizzer-net.App.API</AssemblyName>
    <RootNamespace>OlympiadQuizzer.App.Api</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\olympiad-quizzer-net.Core.Domain\olympiad-quizzer-net.Core.Domain.csproj" />
    <ProjectReference Include="..\..\Infrastructure\olympiad-quizzer-net.Infrastructure.SQLite\olympiad-quizzer-net.Infrastructure.SQLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="olympiad-quizzer-net.App.API.L0" />
    <InternalsVisibleTo Include="olympiad-quizzer-net.App.API.L1" />
    <InternalsVisibleTo Include="olympiad-quizzer-net.App.API.L2" />
  </ItemGroup>

  <!-- Copied so a local run finds the bank beside the binary. Guarded by Exists because the
       container build deliberately withholds data/ until the runtime stage (ADR-029) — an
       unguarded Include names a file that is absent there and fails the publish outright. A glob
       that matches nothing is already silent, so only the single-file items need the guard. -->
  <ItemGroup>
    <Content Include="..\..\..\data\questions.db"
             Condition="Exists('..\..\..\data\questions.db')"
             Link="data\questions.db"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\data\images\**"
             Link="data\images\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\data\dev\questions.db"
             Condition="Exists('..\..\..\data\dev\questions.db')"
             Link="data\dev\questions.db"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
