<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>olympiad-quizzer-net.API</AssemblyName>
    <RootNamespace>OlympiadQuizzer.Api</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\olympiad-quizzer-net.Domain\olympiad-quizzer-net.Domain.csproj" />
    <ProjectReference Include="..\..\Infrastructure\olympiad-quizzer-net.SQLite\olympiad-quizzer-net.SQLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\questions.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Data\images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
