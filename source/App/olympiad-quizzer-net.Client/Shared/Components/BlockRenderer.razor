@code {
    [Parameter, EditorRequired] public List<ContentBlock> Blocks { get; set; }
}

@if (Blocks != null)
{
    @foreach (ContentBlock block in Blocks)
    {
        if (block.Type == ContentBlockType.Code)
        {
            <pre><code>@block.Text</code></pre>
        }
        else if (block.Type == ContentBlockType.Image)
        {
            <img src="@block.File" class="explanation-img" alt="@block.Alt" />
        }
        else
        {
            <p>@block.Text</p>
        }
    }
}
