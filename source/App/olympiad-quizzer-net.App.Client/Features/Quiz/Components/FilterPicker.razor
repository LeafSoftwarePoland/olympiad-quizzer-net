@inject IQuestionRepository Repository
@inject ToastService Toasts
@inject ErrorMessageService ErrorMessages

@code {
    [Parameter] public QuestionQuery Query { get; set; }
    [Parameter] public EventCallback<QuestionQuery> QueryChanged { get; set; }

    private FilterOptions _options;
    private bool _loading = true;
    private bool _serverUnavailable;
    private string _errorHeading;
    private string _errorDetail;

    protected override async Task OnInitializedAsync()
    {
        await LoadFiltersAsync();
    }

    private async Task LoadFiltersAsync()
    {
        _loading = true;
        _serverUnavailable = false;
        _errorHeading = null;
        _errorDetail = null;

        try
        {
            _options = await Repository.GetFilterOptionsAsync(System.Threading.CancellationToken.None);
        }
        catch (System.Net.Http.HttpRequestException)
        {
            _serverUnavailable = true;
        }
        catch (QuizDrawException ex)
        {
            SetError(ex.Message);
        }
        catch (Exception)
        {
            SetError(ErrorMessages.GetMessage(null));
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetError(string message)
    {
        int sep = message.IndexOf('\n');
        _errorHeading = sep >= 0 ? message[..sep] : message;
        _errorDetail = sep >= 0 ? message[(sep + 1)..] : null;
    }

    private void ToggleCategory(string value)
    {
        QuestionQuery updated = CloneQuery();
        if (updated.Categories.Contains(value))
        {
            updated.Categories.Remove(value);
        }
        else
        {
            updated.Categories.Add(value);
        }

        QueryChanged.InvokeAsync(updated);
    }

    private void ToggleStage(string value)
    {
        QuestionQuery updated = CloneQuery();
        if (updated.Stages.Contains(value))
        {
            updated.Stages.Remove(value);
        }
        else
        {
            updated.Stages.Add(value);
        }

        QueryChanged.InvokeAsync(updated);
    }

    private void ToggleYear(string value)
    {
        if (!int.TryParse(value, out int year))
        {
            return;
        }

        QuestionQuery updated = CloneQuery();
        if (updated.Years.Contains(year))
        {
            updated.Years.Remove(year);
        }
        else
        {
            updated.Years.Add(year);
        }

        QueryChanged.InvokeAsync(updated);
    }

    private QuestionQuery CloneQuery()
    {
        QuestionQuery cloned = new QuestionQuery
        {
            Limit = Query.Limit
        };
        cloned.Categories.AddRange(Query.Categories);
        cloned.Algorithms.AddRange(Query.Algorithms);
        cloned.Stages.AddRange(Query.Stages);
        cloned.Years.AddRange(Query.Years);
        return cloned;
    }
}

@if (_loading)
{
    <p class="quiz-progress">Ładowanie filtrów…</p>
}
else if (_serverUnavailable)
{
    <ServerUnavailable OnRetry="LoadFiltersAsync" />
}
else if (_errorHeading != null)
{
    <div class="api-error" role="alert">
        <p><strong>@_errorHeading</strong></p>
        @if (_errorDetail != null)
        {
            <p>@_errorDetail</p>
        }
    </div>
}
else if (_options != null)
{
    @if (_options.Stages.Count > 0)
    {
        <fieldset class="filter-section">
            <legend>Etap</legend>
            <div class="filter-chips" role="group" aria-label="Wybierz etap">
                @foreach (FilterOption stage in _options.Stages)
                {
                    bool selected = Query.Stages.Contains(stage.Value);
                    <button class="filter-chip @(selected ? "selected" : "")"
                            @onclick="() => ToggleStage(stage.Value)"
                            aria-pressed="@selected.ToString().ToLowerInvariant()">
                        @stage.Value (@stage.Count)
                    </button>
                }
            </div>
        </fieldset>
    }

    @if (_options.Categories.Count > 0)
    {
        <fieldset class="filter-section">
            <legend>Kategoria</legend>
            <div class="filter-chips" role="group" aria-label="Wybierz kategorię">
                @foreach (FilterOption cat in _options.Categories)
                {
                    bool selected = Query.Categories.Contains(cat.Value);
                    <button class="filter-chip @(selected ? "selected" : "")"
                            aria-pressed="@selected.ToString().ToLowerInvariant()"
                            @onclick="() => ToggleCategory(cat.Value)">
                        @cat.Value (@cat.Count)
                    </button>
                }
            </div>
        </fieldset>
    }

    @if (_options.Years.Count > 0)
    {
        <fieldset class="filter-section">
            <legend>Rok</legend>
            <div class="filter-chips" role="group" aria-label="Wybierz rok">
                @foreach (FilterOption yr in _options.Years)
                {
                    int.TryParse(yr.Value, out int yrInt);
                    bool selected = Query.Years.Contains(yrInt);
                    <button class="filter-chip @(selected ? "selected" : "")"
                            @onclick="() => ToggleYear(yr.Value)"
                            aria-pressed="@selected.ToString().ToLowerInvariant()">
                        @yr.Value (@yr.Count)
                    </button>
                }
            </div>
        </fieldset>
    }
}
