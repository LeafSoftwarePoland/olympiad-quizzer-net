<Project>

  <!-- The single version for the whole solution. Every project under this directory inherits it,
       so the number ships inside each assembly rather than being applied from outside at deploy
       time. MSBuild reads this file automatically; the solution file cannot carry properties.

       Bumped automatically when a pull request opens, and only when the branch still matches main.
       Set it by hand to take a minor or major, and the automation leaves it alone. -->
  <PropertyGroup>
    <Version>1.0.3</Version>
  </PropertyGroup>

</Project>
